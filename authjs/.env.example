# Public base URL of this example (no trailing slash). Register this callback on your dummyoauth client:
# http://localhost:3002/api/auth/callback/dummyoauth
EXAMPLE_APP_ORIGIN=http://localhost:3002

# From dummyoauth dashboard Integration tab
OAUTH_ISSUER=http://localhost:3000/p/demo
OAUTH_CLIENT_ID=demo
OAUTH_CLIENT_SECRET=demo

# Auth.js session encryption (any random string in dev)
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_URL=http://localhost:3002
