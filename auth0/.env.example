# Auth0 application (Regular Web App) — https://manage.auth0.com/
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=replace-with-openssl-rand-hex-32
APP_BASE_URL=http://localhost:3004

# Optional: Auth0 connection name for your dummyoauth OIDC enterprise connection
AUTH0_CONNECTION=dummyoauth

# Documented for the OIDC connection setup (not read by @auth0/nextjs-auth0)
DUMMYOAUTH_ISSUER=http://localhost:3000/p/demo
